{
  "manifest_version": 3,
  "name": "Image Extractor",
  "version": "1.0",
  "description": "Open a viewer tab and extract image URLs from the active tab.",

  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Open Image Extractor Viewer"
  },

  "web_accessible_resources": [
    {
      "resources": ["scripts/content.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
